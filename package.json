{
  "name": "next-backend-starter8",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma contract emit && next build",
    "start": "next start",
    "postinstall": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "db:sign": "prisma db sign",
    "db:seed": "tsx prisma/seed.ts",
    "db:drop": "tsx prisma/drop.ts",
    "db:setup": "prisma contract emit && prisma db init && tsx prisma/seed.ts",
    "db:infer1": "npx prisma contract infer --output ./prisma/contract.prisma",
    "db:infer2": "npx prisma contract emit && npx prisma db sign"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.25",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.10.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "^8.0.0-rc.35",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false
  }
}
