# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# For local development, you can use the following connection string:
# DATABASE_URL="postgresql://<FELHASZNÁLÓ-AZONOSÍTÓ>:<JELSZÓ>@localhost:5432/mydb"

# --- Neon: https://neon.com ---
# DATABASE_URL="postgresql://neondb_owner:<JELSZÓ>@<SAJÁT-VÉGPONT>-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# DIRECT_URL="postgresql://neondb_owner:<JELSZÓ>@<SAJÁT-VÉGPONT>.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Prisma Cloud: https://console.prisma.io/
# --- Prisma Postgres: https://www.prisma.io/docs/concepts/database-connectors/postgresql ---
# DATABASE_URL="postgres://<FELHASZNÁLÓ-AZONOSÍTÓ>:<JELSZÓ>@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"
# DIRECT_URL="postgres://<FELHASZNÁLÓ-AZONOSÍTÓ>:<JELSZÓ>@db.prisma.io:5432/postgres?sslmode=verify-full"

# --- Supabase: https://supabase.com ---
# DATABASE_URL: Transaction pooler (6543), DIRECT_URL: Session pooler (5432)
# A Supabase saját CA-val írja alá a tanúsítványát, ezért a verify-full hibát ad (SELF_SIGNED_CERT_IN_CHAIN).
# Titkosított kapcsolat tanúsítvány-ellenőrzés nélkül: uselibpqcompat=true&sslmode=require
# Ellenőrzéssel: sslmode=verify-full&sslrootcert=supabase-ca.crt
#   A tanúsítvány letöltése: Supabase Dashboard -> Project Settings -> Database -> SSL Configuration -> Download certificate
#   A letöltött fájlt (pl. prod-ca-2021.crt) nevezd át supabase-ca.crt-re, és másold a projekt gyökerébe (a package.json mellé).
# DATABASE_URL="postgresql://postgres.<PROJEKT-AZONOSÍTÓ>:<JELSZÓ>@aws-0-<RÉGIÓ>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.<PROJEKT-AZONOSÍTÓ>:<JELSZÓ>@aws-0-<RÉGIÓ>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

