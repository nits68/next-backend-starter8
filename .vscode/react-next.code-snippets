  "GETmany function": {
    "scope": "javascript,typescript",
    "prefix": "íGETall",
    "body": [
      "export async function GET() {",
      "\ttry {",
      "\t\tconst data = await db.orm.public.Article.include(\"author\").orderBy((e) => e.id.asc()).all();",
      "\t\treturn NextResponse.json(data);",
      "\t} catch (error) {",
      "\t\t// error handling",
      "\t}",
      "}"
    ],
    "description": "Prisma 8: get all records (GET)"
  },
  "GETsearch function": {
    "scope": "javascript,typescript",
    "prefix": "íGETsearch",
    "body": [
      "// Example search params: /api/articles?title=film&author=anna",
      "export async function GET(request: NextRequest) {",
      "\ttry {",
      "\t\t// read and validate the query parameters",
      "\t\tconst title = request.nextUrl.searchParams.get(\"title\");",
      "\t\tconst author = request.nextUrl.searchParams.get(\"author\");",
      "\t\tif (!title || !author) {",
      "\t\t\treturn NextResponse.json(",
      "\t\t\t\t{ message: \"The title and author parameters are required!\" },",
      "\t\t\t\t{ status: 400 },",
      "\t\t\t);",
      "\t\t}",
      "",
      "\t\tconst data = await db.orm.public.Article.include(\"author\")",
      "\t\t\t.where((e) => e.title.ilike(`%\\${title}%`)) // condition on the N side (Article)",
      "\t\t\t.where((e) => e.author.some((r) => r.name.ilike(`%\\${author}%`))) // condition on the 1 side (Author)",
      "\t\t\t.orderBy((e) => e.author.name.asc()) // a relation field (name) can be used directly only in orderBy, not in where",
      "\t\t\t.all();",
      "",
      "\t\treturn NextResponse.json(data);",
      "\t} catch (error) {",
      "\t\t// error handling",
      "\t}",
      "}"
    ],
    "description": "Prisma 8: search by two query parameters, filtering both sides of a 1:N relation (GET)"
  },
  "GETone function": {
    "scope": "javascript,typescript",
    "prefix": "íGETone",
    "body": [
      "type Params = { params: Promise<{ id: string }> };",
      "",
      "export async function GET(_request: NextRequest, { params }: Params) {",
      "\ttry {",
      "\t\t// read and validate the dynamic parameter",
      "\t\tconst p = await params;",
      "\t\tconst id = Number(p.id);",
      "\t\tif (Number.isNaN(id)) {",
      "\t\t\treturn NextResponse.json({ message: \"Invalid id!\" }, { status: 400 });",
      "\t\t}",
      "\t\tconst data = await db.orm.public.Article.include(\"author\").where({ id }).first();",
      "\t\tif (!data) {",
      "\t\t\treturn NextResponse.json({ message: \"No such record!\" }, { status: 404 });",
      "\t\t}",
      "\t\treturn NextResponse.json(data);",
      "\t} catch (error) {",
      "\t\t// error handling",
      "\t}",
      "}"
    ],
    "description": "Prisma 8: get one record by id (GET)"
  },
  "POST function": {
    "scope": "javascript,typescript",
    "prefix": "íPOST",
    "body": [
      "export async function POST(request: NextRequest) {",
      "\ttry {",
      "\t\tconst body = await request.json();",
      "\t\tconst newOne = await db.orm.public.Article.create(body);",
      "\t\treturn NextResponse.json(newOne, { status: 201 });",
      "\t} catch (error) {",
      "\t\t// error handling",
      "\t}",
      "}"
    ],
    "description": "Prisma 8: create a new record (POST)"
  },
  "PATCH function": {
    "scope": "javascript,typescript",
    "prefix": "íPATCH",
    "body": [
      "type Params = { params: Promise<{ id: string }> };",
      "",
      "export async function PATCH(request: NextRequest, { params }: Params) {",
      "\ttry {",
      "\t\t// read and validate the dynamic parameter",
      "\t\tconst p = await params;",
      "\t\tconst id = Number(p.id);",
      "\t\tif (Number.isNaN(id)) {",
      "\t\t\treturn NextResponse.json({ message: \"Invalid id!\" }, { status: 400 });",
      "\t\t}",
      "\t\t// read the request body and remove the id field",
      "\t\tconst body = await request.json();",
      "\t\tdelete body.id; // the primary key must not be overwritten from the body",
      "",
      "\t\tconst updated = await db.orm.public.Article.where({ id }).update(body);",
      "\t\tif (!updated) {",
      "\t\t\treturn NextResponse.json({ message: \"No such record!\" }, { status: 404 });",
      "\t\t}",
      "\t\treturn NextResponse.json(updated);",
      "\t} catch (error) {",
      "\t\t// error handling",
      "\t}",
      "}"
    ],
    "description": "Prisma 8: partial update by id (PATCH)"
  },
  "DELETE function": {
    "scope": "javascript,typescript",
    "prefix": "íDELETE",
    "body": [
      "type Params = { params: Promise<{ id: string }> };",
      "",
      "export async function DELETE(_request: NextRequest, { params }: Params) {",
      "\ttry {",
      "\t\t// read and validate the dynamic parameter",
      "\t\tconst p = await params;",
      "\t\tconst id = Number(p.id);",
      "\t\tif (Number.isNaN(id)) {",
      "\t\t\treturn NextResponse.json({ message: \"Invalid id!\" }, { status: 400 });",
      "\t\t}",
      "\t\tconst deleted = await db.orm.public.Article.where({ id }).delete();",
      "\t\tif (!deleted) {",
      "\t\t\treturn NextResponse.json({ message: \"No such record!\" }, { status: 404 });",
      "\t\t}",
      "\t\t// successful delete, no content to return (204 No Content)",
      "\t\treturn new NextResponse(null, { status: 204 });",
      "\t} catch (error) {",
      "\t\t// error handling",
      "\t}",
      "}"
    ],
    "description": "Prisma 8: delete a record by id (DELETE)"
  },
