// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
model Film {
  id        Int               @id() @default(autoincrement())
  content   String
  createdAt TimestamptzString @default(now())
  title     String            @unique()
  updatedAt TimestamptzString

  @@map("films")
}

model User {
  id        Int             @id() @default(autoincrement())
  createdAt TimestampString @default(now())
  email     String          @unique()
  name      String?
  updatedAt Timestamptz
  username  String?
  posts     Post[]

  @@map("users")
}

model Post {
  id        Int         @id() @default(autoincrement())
  authorId  Int
  content   String?
  createdAt TimestampString @default(now())
  title     String
  updatedAt TimestampString
  author    User       @relation(fields:[authorId], references:[id], map: "posts_authorId_fkey")

  @@index([authorId])
  @@map("posts")
}
