// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
model Film {
  id        Int               @id() @default(autoincrement())
  content   String
  createdAt TimestamptzJsDate @default(now()) @map("created_at")
  title     String            @unique()
  updatedAt TimestamptzJsDate @onCreate(now()) @onUpdate(now()) @map("updated_at")

  @@map("films")
  @@rls
}

model User {
  id        Int               @id() @default(autoincrement())
  createdAt TimestamptzJsDate @default(now()) @map("created_at")
  email     String            @unique()
  name      String?
  updatedAt TimestamptzJsDate @onCreate(now()) @onUpdate(now()) @map("updated_at")
  username  String?
  posts     Post[]

  @@map("users")
  @@rls
}

model Post {
  id        Int               @id() @default(autoincrement())
  authorId  Int               @map("author_id")
  content   String?
  createdAt TimestamptzJsDate @default(now()) @map("created_at")
  title     String
  updatedAt TimestamptzJsDate @onCreate(now()) @onUpdate(now()) @map("updated_at")

  author    User              @relation(fields: [authorId], references: [id], map: "posts_author_id_fkey")

  @@index([authorId])
  @@map("posts")
  @@rls
}
