// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
model Film {
  id        Int                        @id() @default(autoincrement())
  content   String
  createdAt TimestamptzJsDate          @default(now())
  title     String                     @unique()
  updatedAt temporal.UpdatedAtJsDate

  @@map("films")
}

model User {
  id        Int                        @id() @default(autoincrement())
  createdAt TimestamptzJsDate          @default(now())
  email     String                     @unique()
  name      String?
  updatedAt temporal.UpdatedAtJsDate
  username  String?
  posts     Post[]

  @@map("users")
}

model Post {
  id        Int                        @id() @default(autoincrement())
  authorId  Int
  content   String?
  createdAt TimestamptzJsDate          @default(now())
  title     String
  updatedAt temporal.UpdatedAtJsDate
  author    User                       @relation(fields:[authorId], references:[id], map: "posts_authorId_fkey")

  @@index([authorId])
  @@map("posts")
}
