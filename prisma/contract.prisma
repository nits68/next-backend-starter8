// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

// Author and Article are connected via a one-to-many (1:N) relationship,
// where an Author can have many Articles, and each Article belongs to one Author.
model Author {
  id        Int                @id() @default(autoincrement())
  createdAt DateTime           @default(now()) @map("created_at")
  email     String             @unique()
  name      String?
  updatedAt temporal.UpdatedAt @map("updated_at")
  username  String?

  // connection field:
  articles  Article[]

  // CHECK: simple e-mail format (something@something.something)
  @@check(expression: sql`email LIKE '%_@_%._%'`, name: "author_email_format")
  @@map("author")
}

model Article {
  id          Int                @id() @default(autoincrement())
  authorId    Int                @map("author_id")
  content     String?
  createdAt   DateTime           @default(now()) @map("created_at")
  title       String
  updatedAt   temporal.UpdatedAt @map("updated_at")

  published   Boolean?
  rating      Int?
  publishedAt DateTime?          @map("published_at")

  // connection field:
  author      Author             @relation(fields: [authorId], references: [id], map: "article_author_id_fkey")

  // CHECK: the expression must use the database column names (published_at, not publishedAt)
  @@check(expression: sql`rating BETWEEN 1 AND 5`, name: "article_rating_range")
  // if the article is not published (published = false), it cannot have a publication date
  @@check(expression: sql`published OR published_at IS NULL`, name: "article_published_date")
  @@index([authorId]) // Prisma has no field-level indexes like SQL, so the foreign key field needs a model-level index
  @@map("article")
}
